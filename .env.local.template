# NIAT Inside OS — environment variables
# Copy this file to apps/web/.env.local once the project is scaffolded.
# Your Supabase project ref (dpwubohfltgtdyyqinou) is already filled in.
# Replace every <ANGLE_BRACKET> placeholder. NEVER commit this file.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://dpwubohfltgtdyyqinou.supabase.co

# anon/public key -> use the "Publishable key" (sb_publishable_...) from
# Supabase > Settings > API Keys.  Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<PASTE_sb_publishable_KEY>

# service_role key -> the "Secret key" (sb_secret_...) on the same page.
# SERVER ONLY. Never expose to the client / never commit.
SUPABASE_SERVICE_ROLE_KEY=<PASTE_sb_secret_KEY>

# Direct DB connection (for running migrations). Password = the DB password
# you set when creating the project (Settings > Database if you forgot it).
SUPABASE_DB_URL=postgresql://postgres:<DB_PASSWORD>@db.dpwubohfltgtdyyqinou.supabase.co:5432/postgres

# Pooled connection (Transaction mode) for serverless runtime. Get the exact
# string from Settings > Database > Connection pooling. Host/region differ
# from the direct URL, e.g.:
# SUPABASE_POOL_URL=postgresql://postgres.dpwubohfltgtdyyqinou:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Email (Resend) ----
# Create a key at resend.com > API Keys. Test sender works immediately.
RESEND_API_KEY=<PASTE_re_KEY>
EMAIL_FROM=NIAT Inside OS <onboarding@resend.dev>

# ---- App config ----
ALLOWED_DOMAIN=nxtwave.co.in
ADMIN_EMAILS=nalamasa.sanjay@nxtwave.co.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Optional (add later) ----
SENTRY_DSN=
